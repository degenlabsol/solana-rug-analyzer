# ================================================================
# RUG ANALYZER PRO — Environment Variables
# ================================================================
# Termux/Android : copy to .env and fill in your values
# Replit         : add in the Secrets panel instead
# ================================================================

# ── Required ─────────────────────────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_SESSION=1Abc...your_session_string_here

POST_CHAT_ID=@yourchannel
SOURCE_CHAT_IDS=solearlytrending,degenlabsolgroup

# ── Optional (improves analysis quality) ─────────────────────────
HELIUS_API_KEY=       # helius.dev — deployer history
BIRDEYE_API_KEY=      # birdeye.so — top holders

# ── Bot tuning (all optional, defaults shown) ────────────────────
MIN_SCORE=58
MIN_LIQUIDITY_USD=8000
NEW_TOKEN_MIN_MC=15000
NEW_TOKEN_MAX_MC=800000
NEW_TOKEN_MAX_AGE_H=3
OLD_TOKEN_MIN_5M_PCT=12
OLD_TOKEN_MIN_LIQ=30000
POST_COOLDOWN_MS=3600000
PUMPER_MULTIPLES=2,3,5,10
LEADERBOARD_INTERVAL_MS=28800000
MAX_POOL_SIZE=15
MAX_LEADERBOARD=20

# ================================================================
# How to generate TELEGRAM_SESSION
# ================================================================
# 1. npm install
# 2. node generate-session.js
# 3. Copy the printed string → paste as TELEGRAM_SESSION
# ================================================================
