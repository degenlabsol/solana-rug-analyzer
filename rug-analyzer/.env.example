# ================================================================
# RUG ANALYZER PRO — Environment Variables
# ================================================================
# Copy this file to .env and fill in your values.
# On Replit: add values to the Secrets panel instead of a .env file
# ================================================================

# ── Required: Telegram Userbot ───────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_SESSION=1Abc...your_session_string_here

# ── Required: Channels ───────────────────────────────────────────
# Where the bot posts its calls (username or numeric ID)
# Examples:  @mychannel   |   -1001234567890
POST_CHAT_ID=@yourchannel

# Comma-separated list of source chats to monitor (no @)
SOURCE_CHAT_IDS=solearlytrending,degenlabsolgroup

# ── Optional: API Keys (strongly recommended) ────────────────────
HELIUS_API_KEY=
BIRDEYE_API_KEY=
OPENROUTER_API_KEY=

# ── Optional: OpenRouter model (default: mistral-7b free) ────────
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# ── Optional: Tune bot behavior ──────────────────────────────────
# Minimum liquidity in USD to consider a token (default 10000)
MIN_LIQUIDITY_USD=10000

# Minimum score (0-100) to post a call (default 30)
MIN_SCORE=30

# Cooldown between posts in ms (default 28000 = 28s)
POST_COOLDOWN_MS=28000

# Candidate pool TTL in ms (default 1080000 = 18min)
POOL_TTL_MS=1080000

# Pumper check interval in ms (default 720000 = 12min)
PUMPER_CHECK_MS=720000

# Leaderboard post interval in ms (default 21600000 = 6h)
LEADERBOARD_INTERVAL_MS=21600000

# Daily market update interval in ms (default 86400000 = 24h)
MARKET_UPDATE_INTERVAL_MS=86400000

# Multipliers that trigger pumper alerts (comma-separated)
PUMPER_MULTIPLES=2,3,4,5,10

# Dev nuke threshold % (default -65)
DEV_NUKE_THRESHOLD=-65

# Top-10 holder hard reject % (default 55)
MAX_TOP10_PCT=55

# Leaderboard size (default 12)
LEADERBOARD_SIZE=12

# Min gap between DexScreener API calls in ms (default 2000)
DEX_RATE_LIMIT_MS=2000

# ================================================================
# How to generate TELEGRAM_SESSION
# ================================================================
# 1. Make sure Node.js is installed and dependencies are ready:
#       npm install
# 2. Run the session generator once:
#       node generate-session.js
# 3. Follow the prompts (phone number, verification code, 2FA)
# 4. Copy the printed session string into TELEGRAM_SESSION
# ================================================================
