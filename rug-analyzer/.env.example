# ============================================================
# RUG ANALYZER PRO — Konfiguration
# ============================================================
# Kopiere diese Datei zu .env und fülle deine Werte ein.
# Auf Replit: Trage die Werte in die Secrets-Sektion ein!
# ============================================================

# --- Telegram Userbot ---
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_SESSION=1Abc...your_session_string_here

# --- Telegram Ziel-Channel ---
# Wohin der Bot seine Analysen postet (Username oder numerische ID)
# Beispiele: @meinkanal  |  -1001234567890
POST_CHAT_ID=@deinkanal

# --- Quell-Chats zum Überwachen ---
# Komma-getrennte Liste von Usernames (ohne @)
SOURCE_CHAT_IDS=solearlytrending,degenlabsolgroup

# --- Optionale API Keys (verbessern die Analyse deutlich) ---
HELIUS_API_KEY=
BIRDEYE_API_KEY=

