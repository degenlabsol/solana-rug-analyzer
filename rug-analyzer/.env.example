# ================================================================
# RUG ANALYZER PRO — Environment Variables
# ================================================================
# On Replit : add values in the Secrets panel (lock icon)
# Self-hosted: copy this file to .env and fill in your values
# ================================================================

# ── Required: Telegram Userbot ───────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# On Replit the session secret is stored as SESSION_SECRET
# On self-hosted servers use TELEGRAM_SESSION
SESSION_SECRET=1Abc...your_session_string_here
# TELEGRAM_SESSION=1Abc...your_session_string_here  # alternative name

# ── Required: Channels ───────────────────────────────────────────
# Where the bot posts its calls (username or numeric ID)
POST_CHAT_ID=@yourchannel

# Comma-separated source chats to monitor (no @)
SOURCE_CHAT_IDS=solearlytrending,degenlabsolgroup

# ── Optional: API Keys (strongly recommended) ────────────────────
HELIUS_API_KEY=           # helius.dev — deployer history, asset metadata
BIRDEYE_API=              # birdeye.so — top holder distribution (Replit name)
# BIRDEYE_API_KEY=        # alternative name for self-hosted

OPENROUTER_KEY=           # openrouter.ai — daily AI market update (Replit name)
# OPENROUTER_API_KEY=     # alternative name for self-hosted

SOLANATRACKERIO_KEY=      # solanatracker.io — additional token data
ALCHEMY_KEY=              # alchemy.com — Solana RPC fallback
JUPITER_KEY=              # jup.ag — price feed fallback
SVS_API_KEY=              # extra scoring data

# ── Optional: OpenRouter model ───────────────────────────────────
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# ── Optional: Tune bot behavior ──────────────────────────────────
MIN_LIQUIDITY_USD=10000
MIN_SCORE=30
POST_COOLDOWN_MS=28000
POOL_TTL_MS=1080000
PUMPER_CHECK_MS=720000
LEADERBOARD_INTERVAL_MS=21600000
MARKET_UPDATE_INTERVAL_MS=86400000
PUMPER_MULTIPLES=2,3,4,5,10
DEV_NUKE_THRESHOLD=-65
MAX_TOP10_PCT=55
LEADERBOARD_SIZE=12
DEX_RATE_LIMIT_MS=2000

# ================================================================
# How to generate SESSION_SECRET / TELEGRAM_SESSION
# ================================================================
# 1. Install dependencies:  npm install
# 2. Run once:              node generate-session.js
# 3. Enter phone, code, 2FA when prompted
# 4. Copy the printed string → paste as SECRET value
# ================================================================
